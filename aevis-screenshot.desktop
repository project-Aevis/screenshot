[Desktop Entry]
Name=Screenshot
Name[zh_CN]=截图
GenericName=Screenshot Tool
Comment=Project Aevis Screenshot Utility
Exec=/usr/bin/aevis-screenshot
TryExec=aevis-screenshot
Icon=aevis-screenshot
Terminal=false
Type=Application
StartupNotify=true
